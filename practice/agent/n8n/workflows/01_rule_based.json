        "jsCode": "const input = $json.body ?? $json;\nconst message = String(input.message ?? '').trim();\nif (!message) throw new Error('message is required');\nconst text = message.toLowerCase();\nconst rules = [\n  { category: 'access', words: ['login', 'log in', 'sign in', 'войти', 'вход', 'парол'] },\n  { category: 'billing', words: ['bill', 'payment', 'invoice', 'оплат', 'счёт', 'счет', 'списан'] },\n  { category: 'technical', words: ['error', 'broken', 'down', 'ошиб', 'не работает', 'сбой'] },\n];\nconst match = rules.find(rule => rule.words.some(word => text.includes(word)));\nconst urgentWords = ['urgent', 'asap', 'blocked', 'down', 'срочно', 'блокир', 'недоступ'];\nconst urgency = urgentWords.some(word => text.includes(word)) ? 'high' : 'normal';\nconst category = match?.category ?? 'general';\nconst replies = {\n  access: 'Проверим проблему со входом. Не присылайте пароль или коды подтверждения.',\n  billing: 'Передадим обращение специалисту по оплате.',\n  technical: 'Передадим описание технической проблемы специалисту.',\n  general: 'Обращение принято; при необходимости мы уточним детали.',\n};\nreturn { json: { createdAt: new Date().toISOString(), message, category, urgency, summary: message.slice(0, 180), reply: replies[category] } };"
      },
