      "id": "df7f0a2b-7af9-468a-8c76-b0154bfb77c1",
      "name": "Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [440, 520]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\"access\", \"billing\", \"technical\", \"general\"]\n    },\n    \"urgency\": {\n      \"type\": \"string\",\n      \"enum\": [\"high\", \"normal\"]\n    },\n    \"summary\": {\"type\": \"string\"},\n    \"reply\": {\"type\": \"string\"}\n  },\n  \"required\": [\"category\", \"urgency\", \"summary\", \"reply\"],\n  \"additionalProperties\": false\n}"
      },
      "id": "2a12ca51-15f3-4f4f-b641-80020120190e",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [620, 520]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const parsed = $json.output ?? $json;\nconst result = typeof parsed === 'string' ? JSON.parse(parsed) : parsed;\nconst input = $('Incoming Webhook').item.json.body ?? $('Incoming Webhook').item.json;\nconst allowed = ['access', 'billing', 'technical', 'general'];\nif (!allowed.includes(result.category) || !['high', 'normal'].includes(result.urgency)) throw new Error('LLM returned an invalid category or urgency');\nreturn { json: { createdAt: new Date().toISOString(), message: String(input.message ?? ''), category: result.category, urgency: result.urgency, summary: String(result.summary ?? ''), reply: String(result.reply ?? '') } };"
      },
